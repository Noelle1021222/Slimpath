# Edge Function secrets — set with:
#   supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.)

# Public site URL including any base path, used for LINE Pay redirects.
SITE_URL=https://silvercompanion.example.com
# Extra origins allowed to request payment redirects (comma separated), e.g. a staging site.
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# LINE Pay Online API v3 — https://pay.line.me/tw/developers
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
# true → https://sandbox-api-pay.line.me ; false → https://api-pay.line.me
LINEPAY_IS_SANDBOX=true

# SOS SMS — configure one of the providers (Mitake is checked first).
MITAKE_USERNAME=
MITAKE_PASSWORD=
MITAKE_API_URL=https://smsapi.mitake.com.tw/api/mtk/SmSend
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional webhook (Slack / LINE bot relay / ops tooling) for paid bookings and SOS.
NOTIFY_WEBHOOK_URL=

# LINE Login (OIDC) — https://developers.line.biz
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
