{
  "chapter": 3,
  "terms": [
    { "term": "證券帳戶", "en": "Brokerage account", "def": "在券商開立、用來下單買賣的帳戶；委託、成交與對帳都記在它名下，本身不放錢也不放股票。", "anchor": "def-brokerage", "aliases": ["證券戶"] },
    { "term": "交割帳戶", "en": "Settlement account", "def": "與證券帳戶綁定的本人銀行帳戶：買進成交後從這裡扣款，賣出的款項匯進這裡。", "anchor": "def-settle-acct" },
    { "term": "集保帳戶", "en": "Central depository account", "def": "開在集保結算所、記錄你持有哪些股票與股數的帳戶；台股無實體，股票是其中的電子紀錄。", "anchor": "def-depository", "aliases": ["集保存摺"] },
    { "term": "一張", "en": "Round lot (1,000 shares)", "def": "台股整股交易的單位，1 張＝1,000 股；買一張的金額＝股價×1,000。", "anchor": "def-lot", "aliases": ["張", "整股"] },
    { "term": "零股", "en": "Odd lot", "def": "不到一張（1–999 股）的股數，在盤中零股或盤後零股時段以集合競價交易，只能用限價單。", "anchor": "def-odd" },
    { "term": "盤中零股", "en": "Intraday odd-lot trading", "def": "09:00–13:30 的零股交易，09:10 起約每 5 秒集合競價一次；2026/12/7 起 08:30 收單、09:00 首撮。", "anchor": "def-intraday-odd" },
    { "term": "盤後零股", "en": "After-hours odd-lot trading", "def": "收盤後 13:40–14:30 接受零股委託，14:30 以集合競價撮合一次。", "anchor": "def-afterhours-odd" },
    { "term": "盤後定價交易", "en": "After-hours fixed-price trading", "def": "14:00–14:30 接受整股委託、14:30 撮合，成交價固定為當天收盤價，只決定買賣與張數。", "anchor": "def-afterhours", "aliases": ["盤後定價"] },
    { "term": "集合競價", "en": "Call auction", "def": "累積一段時間的委託後一次撮合，選出讓成交張數最多的單一價格；台股開盤、收盤與零股都用它。", "anchor": "def-call-auction" },
    { "term": "逐筆交易", "en": "Continuous trading", "def": "委託一送到就和委託簿比對、能成交就立即成交的撮合方式；台股盤中 09:00–13:25 採用。", "anchor": "def-continuous" },
    { "term": "試撮", "en": "Indicative matching", "def": "開盤前與收盤前，交易所約每 5 秒用當下委託試算並揭露模擬成交價量；只是試算，不會成交。", "anchor": "def-trial", "aliases": ["試算揭示", "試撮價"] },
    { "term": "開盤價", "en": "Opening price", "def": "當天第一筆成交的價格；整股是 09:00 開盤集合競價撮合出來的價格。", "anchor": "def-open" },
    { "term": "收盤價", "en": "Closing price", "def": "13:25–13:30 收單、13:30 集合競價撮合出的價格；那一撮沒成交時，取當天最後一筆成交價。", "anchor": "def-close" },
    { "term": "參考價", "en": "Reference price", "def": "計算當天漲跌與漲跌停的基準，通常是前一交易日收盤價，除權息日會調整；等於參考價叫平盤。", "anchor": "def-ref", "aliases": ["平盤價", "平盤"] },
    { "term": "漲跌停", "en": "Daily price limit", "def": "一般股票單日成交價以參考價 ±10% 為限，再依升降單位往內取；到上限叫漲停、到下限叫跌停。", "anchor": "def-limit", "aliases": ["漲停", "跌停", "漲停板", "跌停板"] },
    { "term": "升降單位", "en": "Tick size", "def": "股價的最小跳動單位，依價位分六級，從未滿 10 元的 0.01 元到 1,000 元以上的 5 元。", "anchor": "def-tick", "aliases": ["跳動單位"] },
    { "term": "限價單", "en": "Limit order", "def": "指定價格的委託：買進設最高價、賣出設最低價，只在該價或更好的價格成交，不保證成交。", "anchor": "def-limit-order", "aliases": ["限價"] },
    { "term": "市價單", "en": "Market order", "def": "不指定價格、立即與委託簿上的對手單成交，保證速度不保證價格；台股只能在盤中逐筆時段使用。", "anchor": "def-market-order", "aliases": ["市價"] },
    { "term": "ROD", "en": "Rest of Day", "def": "當日有效：未成交的部分留在委託簿排隊，到當天收盤失效。", "anchor": "def-rod" },
    { "term": "IOC", "en": "Immediate or Cancel", "def": "立即成交否則取消：送出當下能成交的部分成交，其餘立刻取消。", "anchor": "def-ioc" },
    { "term": "FOK", "en": "Fill or Kill", "def": "全部成交否則取消：送出當下無法全部成交，就整筆取消。", "anchor": "def-fok" },
    { "term": "T+2交割", "en": "T+2 settlement", "def": "成交日 T 之後第 2 個營業日完成款券過戶；買方須在 T+2 上午 10 點前把款項放進交割帳戶。", "anchor": "def-t2", "aliases": ["交割", "T+2", "T+2 交割"] },
    { "term": "違約交割", "en": "Settlement default", "def": "成交後未在期限內備足款項或股票；可能被收最高 7% 違約金、5 年內不得開戶，情節重大有刑責。", "anchor": "def-default" },
    { "term": "手續費", "en": "Brokerage commission", "def": "券商在買進、賣出各收一次的費用，上限為成交金額 0.1425%，可打折、元以下捨去，並有最低收費。", "anchor": "def-fee" },
    { "term": "證交稅", "en": "Securities transaction tax", "def": "賣出時課徵、不能打折的證券交易稅：股票 0.3%、ETF 0.1%、現股當沖 0.15%（至 2027 年底）。", "anchor": "def-tax", "aliases": ["證券交易稅"] },
    { "term": "當沖", "en": "Day trading", "def": "當日沖銷：同一天買賣同一檔同數量、了結部位，只結算價差；需符合資格並簽約，證交稅 0.15%。", "anchor": "def-daytrade", "aliases": ["當日沖銷", "現股當沖"] },
    { "term": "處置股", "en": "Stocks under disposition", "def": "多次被列注意股而受處置的股票：分盤約每 2 分鐘撮合、為期 5 個營業日，可能須預收款券。", "anchor": "def-disposition", "aliases": ["處置"] },
    { "term": "注意股", "en": "Stocks under attention", "def": "漲跌幅、成交量、週轉率等出現異常，被交易所在收盤後公布提醒的股票；本身不限制交易。", "anchor": "def-attention", "aliases": ["注意股票"] },
    { "term": "紅漲綠跌", "en": "Red-up, green-down", "def": "台灣的報價慣例：成交價高於參考價顯示紅色、低於參考價顯示綠色；美股報價多半相反。", "anchor": "def-redgreen" }
  ]
}
