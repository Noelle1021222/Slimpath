{
  "chapter": 6,
  "terms": [
    { "term": "K線", "en": "Candlestick chart", "def": "把每段時間的開高低收畫成一根 K 棒、依時間排列的價格圖；可以是日K、週K、月K 或分鐘K。", "anchor": "def-kline", "aliases": ["K棒", "K 棒", "K 線", "日K"] },
    { "term": "開高低收", "en": "OHLC", "def": "開盤價、最高價、最低價、收盤價；一根 K 棒保存的四個價格。", "anchor": "def-ohlc", "aliases": ["OHLC"] },
    { "term": "實體", "en": "Real body", "def": "K 棒粗的部分，上下兩端是開盤價與收盤價；長度代表開盤到收盤的勝負幅度。", "anchor": "def-body" },
    { "term": "上影線", "en": "Upper shadow", "def": "實體上緣到最高價的細線；長上影線代表盤中衝高後被賣回，上方有賣壓。", "anchor": "def-upper" },
    { "term": "下影線", "en": "Lower shadow", "def": "實體下緣到最低價的細線；長下影線代表盤中下殺後被買回，下方有承接。", "anchor": "def-lower" },
    { "term": "紅K", "en": "Bullish candle", "def": "收盤價高於開盤價的 K 棒（台灣慣例畫紅色）；比的是同一天的開盤，不是昨收。", "anchor": "def-red-k", "aliases": ["紅 K"] },
    { "term": "黑K", "en": "Bearish candle", "def": "收盤價低於開盤價的 K 棒，台灣看盤軟體多畫成綠色；可能出現「報價收漲的黑K」。", "anchor": "def-black-k", "aliases": ["黑 K", "綠K"] },
    { "term": "十字線", "en": "Doji", "def": "開盤價與收盤價相同或極接近、實體縮成橫線的 K 棒，代表買賣雙方打成平手。", "anchor": "def-doji" },
    { "term": "成交量", "en": "Volume", "def": "一段時間內成交的數量；個股以張計、大盤常看成交金額。量要和自己的均量比。", "anchor": "def-volume", "aliases": ["量", "成交值", "均量"] },
    { "term": "爆量", "en": "Volume spike", "def": "成交量突然放大到均量的好幾倍，代表很多人在這個價位用真金白銀表態。", "anchor": "def-burst" },
    { "term": "量縮", "en": "Shrinking volume", "def": "成交量明顯低於均量，參與者少，走勢比較容易被推翻。", "anchor": "def-shrink" },
    { "term": "價量關係", "en": "Price–volume relationship", "def": "把價格方向和成交量大小一起讀：大量中的移動較有份量，小量中的移動較易反轉。", "anchor": "def-pv" },
    { "term": "均線", "en": "Moving average", "def": "移動平均線：最近 N 個交易日收盤價的平均，每天加入新收盤、移出最舊一天；永遠落後價格。", "anchor": "def-ma", "aliases": ["移動平均線", "簡單移動平均", "SMA"] },
    { "term": "5日線", "en": "5-day moving average", "def": "最近 5 個交易日收盤平均，約一週，俗稱週線。", "anchor": "def-ma5", "aliases": ["週線", "5 日線"] },
    { "term": "10日線", "en": "10-day moving average", "def": "最近 10 個交易日收盤平均；計畫用它做最後 1/3 部位的移動停利參考。", "anchor": "def-ma10", "aliases": ["10 日線"] },
    { "term": "月線", "en": "20-day moving average", "def": "最近 20 個交易日收盤平均，約一個月；計畫的加碼條件之一是大盤「站回月線」。", "anchor": "def-ma20", "aliases": ["20日線", "20 日線"] },
    { "term": "季線", "en": "60-day moving average", "def": "最近 60 個交易日收盤平均，約一季；常被視為中期趨勢與平均成本的參考。", "anchor": "def-ma60", "aliases": ["60日線", "60 日線"] },
    { "term": "年線", "en": "240-day moving average", "def": "最近約 240 個交易日收盤平均，約一年，代表長期趨勢。", "anchor": "def-ma240", "aliases": ["240日線"] },
    { "term": "站上", "en": "Close above", "def": "收盤價回到某條均線或價位之上；跌破後再回到上方叫「站回」。", "anchor": "def-stand", "aliases": ["站回"] },
    { "term": "多頭排列", "en": "Bullish alignment", "def": "短均線在上、長均線在下且都往上走；順序全部倒過來且往下走叫空頭排列。", "anchor": "def-ma-order", "aliases": ["空頭排列"] },
    { "term": "均線下彎", "en": "Declining moving average", "def": "均線數值一天比一天低；代表最近 N 天的平均成本在下降。上升叫上彎或翻揚。", "anchor": "def-ma-down", "aliases": ["下彎", "上彎", "翻揚"] },
    { "term": "扣抵價", "en": "Drop-off price", "def": "N 個交易日前、明天會被移出均線計算的收盤價；今天收盤高於它均線上升，低於它均線下降。", "anchor": "def-deduct", "aliases": ["扣抵"] },
    { "term": "支撐", "en": "Support", "def": "價格跌到附近時容易出現買盤而止跌的區間；常來自前低、均線、整數關卡與成交密集區。", "anchor": "def-support" },
    { "term": "壓力", "en": "Resistance", "def": "價格漲到附近時容易遇到賣盤的區間；常來自前高、套牢區、下彎的均線與整數關卡。", "anchor": "def-resistance", "aliases": ["遇壓"] },
    { "term": "套牢", "en": "Trapped holders", "def": "買在較高價、帳面虧損的人；價格回到成本附近時想解套賣出，形成壓力。", "anchor": "def-trapped", "aliases": ["套牢區", "解套"] },
    { "term": "趨勢", "en": "Trend", "def": "價格的主要方向，用轉折點排列判斷：高低點都墊高是上升趨勢，都降低是下降趨勢。", "anchor": "def-trend" },
    { "term": "盤整", "en": "Consolidation", "def": "高低點在一個區間來回、分不出方向的走勢。", "anchor": "def-range" },
    { "term": "突破", "en": "Breakout", "def": "收盤價越過壓力區；帶量突破比量縮突破更有份量。", "anchor": "def-breakout" },
    { "term": "跌破", "en": "Breakdown", "def": "收盤價落到支撐區之下；兩份文件的確認線都以收盤價為準。", "anchor": "def-breakdown", "aliases": ["失守"] },
    { "term": "假突破", "en": "False breakout", "def": "盤中或短暫越過關卡、隨後又回到原區間的走勢；用收盤價確認可以過濾一部分。", "anchor": "def-false-break", "aliases": ["假跌破"] },
    { "term": "回測", "en": "Retest", "def": "突破或跌破後，價格回到原關卡附近測試它是否已角色互換。", "anchor": "def-retest" },
    { "term": "缺口", "en": "Gap", "def": "今天的價格區間和昨天完全沒有重疊，K 線圖上留下空白；俗稱跳空。", "anchor": "def-gap", "aliases": ["跳空"] }
  ]
}
